# 1) Google Gemini — 무료 (https://aistudio.google.com/apikey)
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=

# 비워 두면 gemini-3.1-flash-lite. 모델 이름은 계속 바뀌므로 지금 쓸 수 있는 것으로 적어 둔다.
GEMINI_MODEL=
# 생각(thinking) 예산. 기본 none — 켜 두면 답 토큰을 생각에 다 쓰고 빈 답이 온다.
GEMINI_REASONING=

# 2) Groq — 무료 (https://console.groq.com/keys)
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
# 비워 두면 **자리마다 다른 모델**을 쓴다 (server/llm.mjs 의 models):
#   1번 키 qwen/qwen3.8-27b · 2번 openai/gpt-oss-20b · 3번 openai/gpt-oss-120b · 4번 groq/compound
# 같은 곳이라도 모델이 다르면 고르는 코스가 달라져 추천이 다양해진다.
# 아래는 **모든 자리**를 한 모델로 묶을 때. 한 자리만 바꾸려면 GROQ_MODEL2 처럼 번호를 붙인다.
GROQ_MODEL=

# 한 제공자만 쓰고 싶을 때 (gemini · groq)
# — 어느 모델이 무엇을 고르는지 견줄 때 쓴다.
LLM_PROVIDER=
